PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/disbursement
REDIS_URL=redis://localhost:6379
PAYMENT_MODE=simulation
KORAPAY_SECRET=replace-with-kora-test-or-live-secret
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_ALLOWED_HOSTS=api.korapay.com
DISCORD_SUCCESS_WEBHOOK_URL=https://discord.com/api/webhooks/replace/success-token
DISCORD_FAILURE_WEBHOOK_URL=https://discord.com/api/webhooks/replace/failure-and-worker-error-token
CORS_ORIGINS=http://localhost:3001,https://disbursement.liqwifi.com,https://liqwifi.com
TYPEORM_SYNCHRONIZE=false
INTERNAL_API_TOKEN=replace-with-a-long-random-token
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
ALLOWED_CURRENCIES=NGN
MAX_TRANSACTION_AMOUNT=10000000.00
MAX_BATCH_AMOUNT=100000000.00
KORAPAY_PUBLIC_KEY=replace-with-kora-public-key
KORAPAY_SECRET_KEY=replace-with-kora-secret-key
KORAPAY_ENCRYPTION_KEY=replace-with-kora-encryption-key
