# Copy this file to <AWS_DEPLOY_PATH>/shared/.env on the AWS server.
# Keep it outside Git and run: chmod 600 <AWS_DEPLOY_PATH>/shared/.env

# Use the complete AWS RDS PostgreSQL connection URL. Do not point this at a
# Docker service name. Percent-encode URL-reserved characters in the password.
DATABASE_URL=postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/database_name?sslmode=require

REDIS_PASSWORD=replace-with-a-url-safe-random-password
REDIS_URL=redis://:replace-with-a-url-safe-random-password@redis:6379

INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
CORS_ORIGINS=https://pay.example.com

PAYMENT_MODE=simulation

# PAYMENT_MODE=live calls Kora. Use a test secret for Kora sandbox testing or a
# live secret only when real payouts are intended.
KORAPAY_SECRET=
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_ALLOWED_HOSTS=api.korapay.com

# Use two different Discord channel webhook URLs.
DISCORD_SUCCESS_WEBHOOK_URL=https://discord.com/api/webhooks/replace/success-token
DISCORD_FAILURE_WEBHOOK_URL=https://discord.com/api/webhooks/replace/failure-token
